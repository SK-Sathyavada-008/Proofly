# ─────────────────────────────────────────────────────────────
# Proofly / Evalora — Production Environment Configuration
# Copy this file to `.env` for local development.
# NEVER commit `.env`, `.env.local`, service account JSON keys, or live secrets.
# ─────────────────────────────────────────────────────────────

# Firebase Web SDK Configuration (Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# Firebase App Check (Required for production Firebase AI Logic attestation)
# Create a reCAPTCHA v3 site key in Google Cloud / Firebase Console -> App Check
VITE_FIREBASE_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_V3_SITE_KEY

# Optional: Platform Super Admin email (never hardcode personal emails in source code)
# Prefer Firebase Auth Custom Claims (`platformRole: "SUPER_ADMIN"`) in production.
VITE_PLATFORM_ADMIN_EMAIL=

# ─────────────────────────────────────────────────────────────
# Server-Side / Serverless Backend Secrets (NEVER prefix with VITE_)
# Used exclusively by serverless functions (api/evaluate-repo.ts, api/webhook.ts)
# ─────────────────────────────────────────────────────────────
GITHUB_TOKEN=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN
GITHUB_WEBHOOK_SECRET=YOUR_WEBHOOK_HMAC_SECRET
GEMINI_API_KEY=YOUR_SERVER_ONLY_GEMINI_API_KEY
