# ─────────────────────────────────────────────────────────────
# Proofly — Firebase Web Application Environment Configuration
# Copy this file to `.env` for local development.
# NEVER commit `.env`, `.env.*`, `.vercel/`, service-account JSONs,
# or private keys.
#
# CRITICAL SECURITY RULE:
# Vite exposes EVERY `VITE_*` variable into the public browser bundle.
# NEVER place privileged credentials (GitHub PATs, Gemini API keys,
# webhook secrets, admin passwords, or service account keys) in any
# `VITE_*` variable. Privileged secrets belong exclusively in Firebase
# Functions Secret Manager (`firebase functions:secrets:set`).
# ─────────────────────────────────────────────────────────────

# Firebase Web SDK Configuration (Firebase Console -> Project Settings -> General)
# These are public Firebase client identifiers; access control is enforced via
# Firestore Security Rules, Storage Rules, Firebase Auth, and App Check.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# Firebase App Check (Required for production Firebase AI Logic attestation)
# Create a reCAPTCHA v3 site key in Google Cloud / Firebase Console -> App Check
VITE_FIREBASE_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_V3_SITE_KEY

# Artifact Storage Backend:
# - 'firestore-chunks' (DEFAULT — 100% Firebase Spark Free Tier, no Blaze bucket needed, <= 8 MB/file)
# - 'firebase-storage' (Optional — requires Blaze plan + provisioned Cloud Storage bucket, <= 25 MB/file)
VITE_STORAGE_BACKEND=firestore-chunks

# Optional: Local Firebase Emulator toggle for development & integration testing
VITE_USE_FIREBASE_EMULATORS=false
